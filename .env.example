# Local dev database (Postgres on port 5499). In production: pooled URL in DATABASE_URL, direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres@localhost:5499/playtest_lite"
DIRECT_URL="postgresql://postgres@localhost:5499/playtest_lite"
# Tests use the separate schema "test" in the same local database. Must contain schema=test.
TEST_DATABASE_URL="postgresql://postgres@localhost:5499/playtest_lite?schema=test"

# Public base URL used in email links
APP_URL="http://localhost:3400"

# Email via Resend. Leave empty to write emails to the dev outbox (/dev/outbox).
RESEND_API_KEY=""
EMAIL_FROM="Playtest <hello@example.com>"
# Show /dev/outbox in production (staging only!)
ALLOW_DEV_OUTBOX=""

# Sign in with Google (optional; the button shows only when both are set). Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe test mode (optional). Without a key, reviews and calls are recorded as "payments not set up".
# A live key (sk_live_) is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=""
# Two Stripe webhook endpoints share the URL APP_URL/api/stripe/webhook; each has its own signing secret (either is accepted):
# - Platform endpoint ("events on your account"): charge.dispute.created, charge.dispute.closed, invoice.paid, invoice.payment_failed,
#   invoice.payment_action_required, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=""
# - Connect endpoint ("events on connected accounts"), same URL: account.updated, payout.failed, payout.paid
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_ALLOW_LIVE=""
# Publishable key (pk_test_...): Stripe's own pop-ups in the page: the 3D Secure card check after a chargeback, and a bank asking to confirm a payment. Not needed in dev without Stripe.
STRIPE_PUBLISHABLE_KEY=""

# Free during launch: every developer has the subscription perks until this date (an ISO date, e.g. 2027-03-01). Unset: free with no end.
# Set it at least 30 days ahead: developers are told 30 days and 7 days before (even with email Off).
FREE_UNTIL=""

# Recordings: Cloudflare R2 when all four are set; otherwise saved to ./uploads on local disk (dev only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Secret for the daily job GET /api/cron/daily (auto-pay after 14 days, payment holds, Open until heads-ups)
CRON_SECRET=""

# Comma-separated admin emails: can open /admin
ADMIN_EMAILS="owner@example.com"
# The owner: only this admin sees the red "Settings to fix" box on the admin dashboard (unset: every admin sees it)
OWNER_EMAIL=""

# Outages (batch 15 section 10): only with OUTAGE_CHECKS=1. Outages come from the uptime service's OWN alerts, never from missing pings:
# in UptimeRobot add an Alert Contact of type "Webhook", method POST, URL APP_URL/api/health/alert?key=<HEALTH_KEY>, "Send as JSON" with
#   {"alertType": "*alertType*", "alertDateTime": "*alertDateTime*", "alertDuration": "*alertDuration*", "monitorFriendlyName": "*monitorFriendlyName*"}
# and attach it to the monitor (alert when down and when up). A "down" is stored; the matching "up" records an outage when it lasted 15 minutes or more.
# The monitor's keyed ping GET /api/health?key=<HEALTH_KEY> writes heartbeats for information only. Use a long random secret for HEALTH_KEY.
OUTAGE_CHECKS=0
HEALTH_KEY=change-me-long-random-secret

# Storage running out (batch 30 §35): the daily job measures the database (pg_database_size) and the stored uploads against these limits, in GB (decimals
# allowed). At 80% or more: a red box on the admin console, one admin bell line, and the keyed /api/health says "degraded: storage". Empty = not checked.
DB_STORAGE_LIMIT_GB=""
UPLOADS_LIMIT_GB=""

# Testing only: SKIP_EMAIL_CONFIRM=1 skips the email-confirmation requirement (the banner says it's off). Ignored when
# NODE_ENV=production, so the live site always requires a confirmed email.
SKIP_EMAIL_CONFIRM=0
