# Local dev database (Postgres on port 5499). In production: pooled URL in DATABASE_URL, direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres@localhost:5499/playtest_lite"
DIRECT_URL="postgresql://postgres@localhost:5499/playtest_lite"
# Tests use the separate schema "test" in the same local database. Must contain schema=test.
TEST_DATABASE_URL="postgresql://postgres@localhost:5499/playtest_lite?schema=test"

# Public base URL used in email links
APP_URL="http://localhost:3400"

# Email via Resend. Leave empty to write emails to the dev outbox (/dev/outbox).
RESEND_API_KEY=""
EMAIL_FROM="Playtest <hello@example.com>"
# Show /dev/outbox in production (staging only!)
ALLOW_DEV_OUTBOX=""

# Sign in with Google (optional; the button shows only when both are set). Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe test mode (optional). Without a key, reviews and calls are recorded as "payments not set up".
# A live key (sk_live_) is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint APP_URL/api/stripe/webhook (event: charge.dispute.created)
STRIPE_WEBHOOK_SECRET=""
STRIPE_ALLOW_LIVE=""

# Recordings: Cloudflare R2 when all four are set; otherwise saved to ./uploads on local disk (dev only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Secret for the daily job GET /api/cron/daily (auto-pay after 14 days, payment holds, Open until heads-ups)
CRON_SECRET=""

# Comma-separated admin emails: can open /admin
ADMIN_EMAILS="owner@example.com"

# Outage checks (NEWEST+6): only with OUTAGE_CHECKS=1 does the app detect outages, and only the outside uptime
# checker's ping GET /api/health?key=<HEALTH_KEY> writes heartbeats. Use a long random secret for HEALTH_KEY.
OUTAGE_CHECKS=0
HEALTH_KEY=change-me-long-random-secret

# Testing only: SKIP_EMAIL_CONFIRM=1 skips the email-confirmation requirement (the banner says it's off). Ignored when
# NODE_ENV=production, so the live site always requires a confirmed email.
SKIP_EMAIL_CONFIRM=0
