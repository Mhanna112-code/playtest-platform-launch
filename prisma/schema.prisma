generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Money is always whole cents (Int).

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String    @default("")
  /// "she" | "he" | "they" | "" (blank: wording uses "they")
  pronoun     String    @default("")
  isDeveloper Boolean   @default(false)
  /// (NEXT-UI 6) The side in use now when the account has both: "developer" | "tester" ("" = not chosen yet)
  side        String    @default("")
  isTester    Boolean   @default(false)
  isAdmin     Boolean   @default(false)
  /// (NEWEST+7) bcrypt hash ("" = no password yet: set one through Forgot password)
  passwordHash    String    @default("")
  emailVerifiedAt DateTime?
  /// (Owner, Oct 30, batch 15 section 16) Suspensions are per side. The developer side keeps the old columns (suspendedAt, suspendNote, suspendedById, reinstatedAt);
  /// the tester side has its own set. A developer-side suspension pauses their tests; a tester-side one removes them from the tests they're in.
  devSuspendedAt   DateTime? @map("suspendedAt")
  devSuspendNote   String    @default("") @map("suspendNote")
  /// (Design doc 11.4) The admin who suspended that side, and when it was lifted (the "Your account is active again" notice)
  devSuspendedById String?   @map("suspendedById")
  devReinstatedAt  DateTime? @map("reinstatedAt")
  testerSuspendedAt   DateTime?
  testerSuspendNote   String    @default("")
  testerSuspendedById String?
  testerReinstatedAt  DateTime?
  /// (Design doc 2, 10) A deleted account: when, by whom ("self" | "admin") and why. History stays; nothing else of it works.
  deletedAt     DateTime?
  deletedBy     String    @default("")
  deleteReason  String    @default("")
  /// (Design doc 9) A tester's payout failed ("Your bank couldn't receive a payout"): since when, and the last 3-day bell reminder
  /// (Design doc 6) The Alerts menu: update types the developer chose NOT to be stopped for (see src/lib/alerts.ts)
  ignoredAlerts     String[]  @default([])
  /// (Batch 15 section 26) The tester's one-press Alerts: Off = only changes to their contract (a new terms offer, their key marked working) stop a press
  testerAlertsOff   Boolean   @default(false)
  payoutProblemAt   DateTime?
  payoutRemindedAt  DateTime?
  /// (Batch 18 section 13) Unused since batch 21 replaced the Jitsi practice room with the in-app camera and microphone check (kept: no column drops).
  callCheckId       String?   @unique
  /// (Batch 18 section 1) The Terms of Use version this account accepted (at sign-up, or again from the box under Post / Join / Apply / Ask to rejoin), and when.
  /// 0 = never accepted (an account made before sign-up asked, or through Google). Compared with TERMS_VERSION (src/lib/termsOfUse.ts).
  termsVersion      Int       @default(0)
  termsAcceptedAt   DateTime?
  /// (Owner, Oct 28, batch 20 section 5) When the account confirmed it is 18 or older (the sign-up tick, Google's sign-up step, or the updated-Terms box). Null = not yet.
  ageConfirmedAt    DateTime?
  createdAt   DateTime  @default(now())

  /// Stripe: developer's customer + saved card; tester's Connect account
  stripeCustomerId      String? @unique
  stripePaymentMethodId String?
  cardExpMonth          Int?
  cardExpYear           Int?
  stripeAccountId       String? @unique
  payoutsReady          Boolean @default(false)
  /// (Owner, Oct 28, batch 8) The developer subscription ($7/month): "none" | "active" | "past_due" (a renewal was declined; Stripe retries for about a week, the perks
  /// continue) | "ended" (subscriptionEndReason: "cancelled" | "lapsed" | "deleted")
  subscriptionStatus     String    @default("none")
  /// The Stripe subscription id, or "manual" when Stripe Billing isn't set up (renewals recorded by the daily job)
  subscriptionId         String?
  subscribedAt           DateTime?
  /// The day renewals count from (monthly; the 31st renews on the last day of shorter months). Moves later by the time billing was paused
  subscriptionAnchorAt   DateTime?
  /// The end of the paid month: the next renewal, or the end when cancelled
  subscriptionRenewsAt   DateTime?
  subscriptionCanceling  Boolean   @default(false)
  subscriptionEndedAt    DateTime?
  subscriptionEndReason  String    @default("")
  /// When a declined renewal made it past due (the lapse comes after the last retry)
  subscriptionPastDueAt  DateTime?
  /// Billing paused by a payment hold, a chargeback hold or a suspension (the paid days left resume when it lifts)
  subscriptionPausedAt   DateTime?
  /// Payment hold: set while the developer owes money (a failed charge unpaid after 3 days, or a chargeback)
  holdStartedAt DateTime?
  holdReason    String    @default("")
  /// (Owner, Oct 27) How many payment holds this account has had (each start counts). After the 3rd, every later hold needs an admin's Approve to lift
  /// (holdApprovedAt), even once what is owed is paid. Cleared when a hold lifts.
  holdCount      Int       @default(0)
  holdApprovedAt DateTime?
  holdApprovedById String?
  /// (Batch 11) Automatic retries of what is owed during this hold: how many were tried (at most 7 a hold) and when the last one ran
  holdRetries    Int       @default(0)
  holdRetryAt    DateTime?
  /// No longer used (the 30-day admin alert was replaced by closing paused tests after 7 days); kept so the running app's client still matches
  holdAlertedAt DateTime?
  /// (Owner, Oct 26) A chargeback hold lifts only after: a card re-verified with 3D Secure (chargebackCardVerifiedAt), what is owed paid,
  /// and the admin's approval (chargebackApprovedAt). Both are cleared when the hold lifts or a new chargeback opens.
  chargebackCardVerifiedAt DateTime?
  chargebackApprovedAt     DateTime?
  /// Email settings (Owner, Oct 26): "off", or on with "daily" (default) | "weekly" | "monthly". One email lists every notification since the last one;
  /// payment lines also go out in an end-of-day email for weekly / monthly. The always-send emails (account paused ...) ignore it. The bell keeps everything.
  emailPref     String    @default("daily")
  /// Last summary email (daily / weekly / monthly settings)
  lastSummaryAt DateTime?
  /// (NEWEST+9) The most testers per test this developer has earned so far (it never shrinks; see src/lib/capacity.ts)
  testerLimit   Int       @default(10)
  /// (Batch 15 section 11) The person's IANA time zone, sent by their browser ("" = unknown: UTC). Every time in their bell lines and emails is written in it.
  timeZone      String    @default("")

  notifications Notification[]

  sessions  Session[]
  profile   TesterProfile?
  tests     Test[]
  contracts Contract[]
  messages  Message[]
  chatReads ChatRead[]
  keptForms KeptForm[]
  excerpts  Excerpt[]
  /// (Batch 17 §18) Join pages this tester opened while not in the test ("Tests visited")
  testVisits TestVisit[]
}

/// (Batch 15 section 7) Sign-in and sign-up attempts, for the limits (5 failed tries per email or 20 per network in 15 minutes; 10 new accounts per network an hour).
/// ip = the first address of x-forwarded-for. The daily job deletes rows older than a day.
model LoginAttempt {
  id    String   @id @default(cuid())
  email String
  ip    String
  /// "login" | "signup"
  kind  String   @default("login")
  ok    Boolean
  at    DateTime @default(now())

  @@index([email, at])
  @@index([ip, at])
}

/// One-use sign-in link tokens (only the SHA-256 hash is stored)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  /// "reset" (choose a new password) | "verify" (confirm the email) | "login" (old email links, no longer issued)
  kind      String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TesterProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices    String[]
  categories String[]
  languages  String[]
  bio        String   @default("")
  updatedAt  DateTime @updatedAt
}

model Test {
  id          String   @id @default(cuid())
  developerId String
  developer   User     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  title       String
  /// (Design doc 4) The game, website, app or other product (60 characters); the title above is this test's own name (60)
  productName String   @default("")
  /// (Design doc 4) Mature (18+): the developer says why the content is mature (required when ticked)
  mature      Boolean  @default(false)
  matureWhy   String   @default("")
  /// (Design doc 4) Optional NDA: text testers must accept before joining ("" = none)
  ndaText     String   @default("")
  /// (Owner, Oct 28 afternoon) Per limited field, the Saves that changed it after the first tester joined: { description, ndaText, questions, languages, devices } (a missing key = 0).
  /// Each field has its OWN limit of 3. Prices, parts, the build link and access keys are not limited
  criticalCounts Json @default("{}")
  /// (Design doc 6, 10) An admin paused this test (it behaves like a stop for the developer, who can only stop it) or stopped it, and the note
  adminPausedAt   DateTime?
  adminStoppedAt  DateTime?
  adminNote       String   @default("")
  /// (Owner, Oct 26) Which admin paused / stopped it (the admin dashboard lists each admin's own actions)
  adminPausedById  String?
  adminStoppedById String?
  /// (Owner, Oct 26) A paused test closes after 7 days (whatever the cause). The admin can move that date (valid only if set during the
  /// current pause: pauseCloseSetAt >= the pause's start); pauseClosedAt/Reason record a closure caused by the pause.
  pauseCloseAt      DateTime?
  pauseCloseSetAt   DateTime?
  /// (Owner, Oct 28 night, batch 9) When this test was first paused, whatever the causes: ONE 7-day clock while it stays paused (a second cause starting or one
  /// cause lifting while another remains never restarts it). Cleared when no cause is left.
  pausedSince       DateTime?
  pauseClosedAt     DateTime?
  pauseClosedReason String   @default("")
  description String   @default("")
  buildUrl    String   @default("")
  /// The full app's categories (at least one)
  categories  String[] @default([])
  /// Devices a tester needs (any one of them); empty = any device
  devices     String[]
  languages   String[]
  spots       Int
  /// Prices in cents; null = this kind of work isn't offered; 0 = free
  writtenCents   Int?
  recordingCents Int?
  /// Live call: hourly rate (cents) and booked length (minutes); null = no live call
  liveRateCents Int?
  liveMinutes   Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  /// Each tester's deadline: days from their own join (late work is still allowed, marked "Sent late")
  deadlineDays  Int
  /// After this date: no new joiners, no sending, no booking (null = no end date). (Batch 15 section 18) The last day to JOIN.
  openUntil     DateTime?
  /// (Owner, Oct 30, batch 15 section 18) Every tester's days: from when the test opened (posted, or a Next round opened) to Open until. Each tester's deadline is
  /// the day they join + these days. Edit moving Open until later by D days adds D. (null on tests older than batch 15 that never got it)
  testerDays    Int?
  /// Questions for written answers (array of strings)
  questions     Json     @default("[]")
  /// Who can join: "anyone" (Join) | "apply" (Apply to join; the developer accepts) | "invite" (invite only)
  joinMode      String   @default("anyone")
  /// "draft" | "open" | "closed" (no new joiners) | "stopped" (for good)
  status        String   @default("open")
  round         Int      @default(1)
  previousId    String?
  /// Any change to the test (edit, join that used a spot, next round, stop): checked by Edit's Save
  version       Int      @default(1)
  /// Changes to the listing's terms only: checked by Join
  listingVersion Int     @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stoppedAt     DateTime?

  contracts Contract[]
  slots     CallSlot[]
  events    TestEvent[]
  invites   Invite[]
  accessKeys AccessKey[]
  excerpts   Excerpt[]
  visits     TestVisit[]
  /// Open until heads-up notices sent (3 days and 1 day before)
  notified3d Boolean @default(false)
  /// Countdown notices already sent for Open until: "1m" | "1w" | "3d" | "1d". (Batch 16 section 1) Also each working tester's own deadline marks,
  /// per contract and per deadline: "due:<contractId>:<deadline ms>:<mark>" (and ":seen" once the daily job has looked at that deadline)
  notifiedMarks String[]
  notified1d Boolean @default(false)

  @@index([developerId])
  @@index([status])
}

/// What happened on a test: feeds the stop-once box (top panel) and Edit's "what changed" list.
model TestEvent {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  /// Stop-once kinds: "joined" | "left" | "sent" | "booked" | "confirmed" | "cancelled" | "offered" | "removed" | "paid".
  /// Others: "edited" | "next_round" | "stopped" | "ended" | "opened"
  kind      String
  text      String
  /// The tester this is about (for the Pay box's stop-once check), if any
  contractId String?
  /// The test's version after this event (when it changed the version)
  version   Int?
  /// (Batch 15 section 35) The row on the page this line opens (an anchor id, e.g. "item-dispute-<id>"), when there is one
  link      String   @default("")
  /// (Batch 34 §9) The browser tab (page load) that made this change, for a listing save: Edit never stops for its own tab's save
  tab       String   @default("")
  createdAt DateTime @default(now())

  @@index([testId, createdAt])
}

/// A tester's place in a test. Every term is copied from the listing at join and never changes.
model Contract {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testerId  String
  tester    User     @relation(fields: [testerId], references: [id], onDelete: Cascade)
  /// The listing version the tester joined on
  listingVersion Int
  title          String
  buildUrl       String
  description    String
  writtenCents   Int?
  recordingCents Int?
  liveRateCents  Int?
  liveMinutes    Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  deadlineDays   Int
  questions      Json
  keepPrivate    Boolean  @default(false)
  /// (Design doc 4) The NDA the tester accepted when they joined ("" = none) and when
  ndaText        String   @default("")
  ndaAcceptedAt  DateTime?
  joinedAt       DateTime @default(now())
  dueAt          DateTime
  /// "working" | "left" | "ended" (developer ended early / stopped the test)
  status         String   @default("working")
  endedAt        DateTime?
  /// When the tester switched to newer terms offered after an Edit (null = still on their original terms)
  termsSwitchedAt DateTime?
  /// "early" (developer ended this tester's work) | "stopped" (the developer stopped the test)
  endKind        String   @default("")
  endReason      String   @default("")
  /// (NEWEST+5) "Rate ..." prompt sent once, when rating first became available (tester side / developer side)
  ratePromptedAt    DateTime?
  devRatePromptedAt DateTime?
  /// (Owner, Oct 27) A tester removed by a suspension dismissed the "Suspended" card on their dashboard
  removedDismissedAt DateTime?

  submissions Submission[]
  recordings  Recording[]
  calls       Call[]
  callSets    CallSet[]
  messages    Message[]
  accessKeys  AccessKey[]
  excerpts    Excerpt[]
  /// (Owner, Oct 29, batch 13) The tester's previous sets of questions and answers, newest first (at most 3): [{ until, items: [{ question, required, answer }] }].
  /// Kept when they switch to terms with changed questions (sent answers or the draft, whatever the form had).
  prevSets    Json     @default("[]")

  @@unique([testId, testerId])
  @@index([testerId])
}

/// Sent work: "written" (answers to the contract's questions) or "recording" (uploaded recordings).
model Submission {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String
  /// Written: (owner, Oct 29, batch 13) the whole set it answers: [{ question, required, answer }] (older rows were a list of answers)
  answers    Json     @default("[]")
  /// (Batch 13) Earlier SENT sets this one replaced (the developer's "Previous questions and answers" fold): [{ until, items }], newest first
  prevSets   Json     @default("[]")
  /// (Batch 13) Set when the tester switched to changed questions after sending this: "Sent for the questions until <date>" (null = the current questions)
  setUntil   DateTime?
  notes      String   @default("")
  /// The listing price for this part from the contract; null = extra work (not in the listing)
  agreedCents Int?
  /// First sent; updated when the tester sends an updated version (allowed until it's paid)
  sentAt     DateTime @default(now())
  updatedAt  DateTime @default(now())
  /// Sent after the tester's own deadline
  late       Boolean  @default(false)
  /// Not paid or rejected by then: the listing amount is paid automatically (moves on with payment holds)
  payBy      DateTime?
  /// Optional "Ask $___ for this" when sending
  askedCents Int?
  /// Last reminder (every 3 days): to the developer for parts outside the contract, to the tester for a waiting choice
  remindedAt DateTime?
  /// Contract parts unreviewed 14 days: the tester chooses "Charge" or "Let it go" by choiceBy, else it's charged
  choiceOfferedAt DateTime?
  /// Countdown notices to the developer before day 14 ("1w" | "3d" | "1d"), then daily after it
  devMarks        String[]
  devRemindedAt   DateTime?
  choiceBy        DateTime?
  /// (Batch 30 §2) The tester sent an updated version after the piece was paid (the latest such send)
  paidUpdateAt     DateTime?
  /// (Batch 30 §2) The developer's Pay more (any amount, $0 included) answered that update: its Needs you row is gone until the next update
  paidUpdateDoneAt DateTime?
  /// (Batch 30 §2) When the developer last closed an update at $0, and their optional note (the tester reads both)
  paidUpdateZeroAt DateTime?
  paidUpdateNote   String    @default("")

  recordings Recording[]
  review     Review?
  dispute    Dispute?
  excerpts   Excerpt[]

  @@unique([contractId, kind])
}

model Recording {
  id           String      @id @default(cuid())
  contractId   String
  contract     Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  storageKey   String
  filename     String
  sizeBytes    Int
  contentType  String
  /// Set once the upload finished
  uploadedAt   DateTime?
  /// (Batch 11) Which part it belongs to: "recording" (the Recording part) or "written" (an attachment on the written part: a file, or a screen recording)
  part         String      @default("recording")
  createdAt    DateTime    @default(now())
}

/// The developer's one Pay (or Reject) press for a piece of sent work or a held call. One per piece.
model Review {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  callId       String?     @unique
  call         Call?       @relation(fields: [callId], references: [id], onDelete: Cascade)
  contractId   String
  amountCents  Int
  /// The listing amount shown beside the box; null = not in the listing
  agreedCents  Int?
  reason       String      @default("")
  /// Reject: nothing charged (amountCents 0); a contract part can still be disputed once
  rejected     Boolean     @default(false)
  /// Paid automatically after 14 days without a review
  auto         Boolean     @default(false)
  /// (Batch 30 §5) The team closed this piece for $0 (this admin); `reason` holds the team's reason. Final: no dispute, no Pay more
  teamClosedById String?
  /// (Batch 9) A call's Pay: the rate typed in the box ($/h, cents), when one was typed; the tester sees it with the amount
  rateCents    Int?
  /// Idempotency: one charge per press, never twice
  payKey       String      @unique
  createdAt    DateTime    @default(now())

  @@index([contractId])
}

/// Every charge (or attempted charge). status: "pending" | "charged" | "not_set_up" (no Stripe key: recorded only) | "failed"
model Payment {
  id           String   @id @default(cuid())
  /// "review" | "call" | "dispute"
  kind         String
  submissionId String?
  callId       String?
  disputeId    String?
  contractId   String?
  developerId  String
  testerId     String
  amountCents  Int
  feeCents     Int
  testerCents  Int
  status       String
  stripePaymentIntentId String?
  /// The tester's share: "sent" (to their Stripe account with the charge), "waiting" (no payout account yet), "none"
  transferStatus String @default("none")
  stripeTransferId String?
  /// A failed charge the developer still owes must be paid by this time, or a payment hold starts
  owedUntil    DateTime?
  /// The daily job retries owed payments once a day
  retriedAt    DateTime?
  /// (Batch 10) When a "Pay what you owe" press claimed this payment (status "paying"); a claim older than 10 minutes can be taken again
  warnedAt     DateTime?
  settledAt    DateTime?
  /// Bank reversal (Stripe dispute): "" | "open" | "resolved" | "won" (batch 10: the platform won it, so it is no longer owed)
  chargeback   String   @default("")
  chargebackAt DateTime?
  stripeChargeId String?
  /// (Owner, Oct 27) A chargeback adds its amount to what the developer owes; this payment is the card charge that repays that reversed payment
  repaysId     String?
  failure      String   @default("")
  /// (Batch 9) The developer's optional note to the tester (extra pay; a Pay's note is the review's reason)
  note         String   @default("")
  /// (Batch 11) The bank wants the cardholder to confirm this payment: the Stripe PaymentIntent to confirm, and by when (status "needs_confirmation" for a charge made
  /// while the developer wasn't there; "needs_action" while a press's confirmation pop-up is open; an owed payment keeps its status)
  actionPi     String?
  actionBy     DateTime?
  /// (Batch 15 section 9) The Stripe idempotency key's press id (the charge's metadata payKey), so a payment stuck "pending" can be found and finished or cleared; a new
  /// press on the same piece within 24 hours of an interrupted one reuses it, so nothing is charged twice. And when it was last checked (at most once a minute).
  payKey       String?
  checkedAt    DateTime?
  /// (Batch 15 section 41, C1 and M2) The press this payment came from ("press:<developer>:<uuid>", "extra:press:…"): a repeat of the same press finds it
  pressKey     String?
  createdAt    DateTime @default(now())

  @@unique([kind, payKey])
  @@unique([kind, pressKey])
  @@index([developerId])
  @@index([testerId])
  @@index([status, createdAt])
}

/// Only for parts in the contract paid below the listing amount; once per part.
model Dispute {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  callId       String?     @unique
  call         Call?       @relation(fields: [callId], references: [id], onDelete: Cascade)
  contractId   String
  testerId     String
  reason       String
  /// The developer's side, added once (shown under the piece; the admin sees both)
  devSide      String      @default("")
  devSideAt    DateTime?
  /// "open" | "decided" | "withdrawn" (owner, Oct 28: the tester deleted their account)
  status       String     @default("open")
  /// The total pay the admin decided (never below what was paid)
  decidedCents Int?
  decisionNote String     @default("")
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())
}

/// A call time the developer offers. Booked by one tester.
model CallSlot {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  minutes     Int
  /// Empty = every tester with a live call in their contract can book; otherwise only these tester ids
  allowedTesterIds String[]
  /// (Batch 18 section 10) No longer used: every call uses its Jitsi room (an own-link option was removed). Kept so older rows read.
  link        String   @default("")
  /// "open" | "booked" | "removed"
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calls Call[]

  @@index([testId, startsAt])
}

model Call {
  id          String    @id @default(cuid())
  slotId      String
  slot        CallSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  minutes     Int
  /// The contract's hourly rate; null = extra (live calls weren't in the tester's listing)
  rateCents   Int?
  /// "booked" | "cancelled"
  status      String    @default("booked")
  cancelledBy String?
  cancelledAt DateTime?
  cancelNote  String    @default("")
  /// Optional "Ask $___ for this" when booking
  askedCents  Int?
  /// The daily/weekly set this call belongs to (the request it came from); shown as one line
  setId          String?
  /// Each side's first Join (the call page shows "Both joined at …"; the length defaults from then to the booked end)
  devJoinedAt    DateTime?
  testerJoinedAt DateTime?
  /// The actual length the developer entered after the call (sets the Pay box reference); null = booked length
  actualMinutes Int?
  /// (The full app's "Why, if shorter") The developer's reason when the length entered is shorter than booked
  lengthNote    String  @default("")
  /// No-show report: who reported ("developer" | "tester"), what happened; an admin can read it
  noShowBy      String?
  noShowNote    String  @default("")
  noShowAt      DateTime?
  /// Listed in an admin digest once
  noShowDigestedAt DateTime?
  /// (Batch 15 section 40) The measured length: the whole minutes both people were in the call page at once (capped at 150% of the booked length), and that time span
  measuredMinutes Int?
  measuredFrom    DateTime?
  measuredTo      DateTime?
  /// When the measured length became final (both left, or 30 minutes after the latest allowed end); null = in progress / measuring
  measuredAt      DateTime?
  /// (Batch 18 section 3) When the call ended because its pay at the call's rate reached what was left of the $1,000 for that tester's calls on the test: the
  /// measured length is final at that point (capped there), the call page says so and Join is refused.
  cappedAt        DateTime?
  /// (Batch 21 section 2) When the server ended the call for real (both pages hang up and the room can't be rejoined), and why: "length" (150% of the booked
  /// length), "calls_cap" (the $1,000), or what closed it: "blocked" | "paused" | "stopped" | "left" | "ended". The measured length is final at that moment.
  endedAt         DateTime?
  endReason       String    @default("")
  /// (Batch 21 section 3) Each side's latest poll of the call room (its page open): "here" for the other side, and "both have left" for the final length
  devSeenAt       DateTime?
  testerSeenAt    DateTime?
  /// (Batch 15 sections 15 and 40) A listed call's review clock: the call's end + 7 days (the review date is the later of this and the tester's deadline); moves with pauses
  payBy           DateTime?
  /// A listed call left unreviewed by its review date: the tester can Charge or Let it go (as a sent part)
  choiceOfferedAt DateTime?
  choiceBy        DateTime?
  /// The developer's review reminders already sent (REVIEW_MARKS) and the last daily / weekly one
  devMarks        String[]  @default([])
  remindedAt      DateTime?
  devRemindedAt   DateTime?
  createdAt   DateTime  @default(now())

  review    Review?
  dispute   Dispute?
  presences CallPresence[]
  signals   CallSignal[]

  @@index([contractId])
}

/// (Batch 15 section 40; batch 21 section 3) One stretch of time a person's browser was connected to the other's in the call room (WebRTC "connected"): each
/// connected report extends it; a gap of 5 minutes or more starts a new one (a shorter gap still counts as connected when measuring).
model CallPresence {
  id      String   @id @default(cuid())
  callId  String
  call    Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId  String
  /// "developer" | "tester"
  side    String
  startAt DateTime
  endAt   DateTime

  @@index([callId, userId])
}

/// (Batch 21 section 1) The call room's connection messages between the two browsers (offers, answers, candidates, camera and microphone state, "left"),
/// relayed through the app by polling. Deleted when the call ends.
model CallSignal {
  id        Int      @id @default(autoincrement())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  fromId    String
  kind      String
  payload   String
  createdAt DateTime @default(now())

  @@index([callId, id])
}

/// (Owner, Oct 30, batch 15 section 43) One Save that changed the terms or the names: the developer's "Contract changes" panel. Who switched or kept comes from the
/// offers it made (TermsOffer.changeId).
model TestChange {
  id        String   @id @default(cuid())
  testId    String
  /// The listing fields changed (terms and names only)
  fields    String[]
  before    Json
  after     Json
  /// "2 applications closed · 1 invite re-sent"
  effects   String   @default("")
  createdAt DateTime @default(now())

  @@index([testId, createdAt])
}

/// (Owner, Oct 30, batch 15 section 24) An entry in ONE tester's contract changes that isn't an offer: a rename ("Renamed: “A · B” → “C · D”"), stored for every working tester.
model ContractNote {
  id         String   @id @default(cuid())
  contractId String
  kind       String
  text       String
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
}

/// Per-test chat between the developer and one tester (in the test, invited, applied, or a past participant).
model Message {
  id         String   @id @default(cuid())
  testId     String   @default("")
  testerId   String   @default("")
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body       String
  /// (Batch 15 section 13) The press id the page sent with this message: a repeat of the same unconfirmed press never posts twice
  clientId   String?
  createdAt  DateTime @default(now())

  @@unique([senderId, clientId])
  @@index([contractId, createdAt])
  @@index([testId, testerId, createdAt])
}

/// (NEXT-UI 4) When each person last opened a chat (per test and tester): the unread badge counts the other side's messages after it
model ChatRead {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId   String
  testerId String
  readAt   DateTime @default(now())

  @@id([userId, testId, testerId])
}

/// (NEXT-UI 10) Typed but not sent: kept on the server per person and form (any device), put back with "Not sent yet"; sending clears it.
/// Only written answers, chat messages, dispute text, rating comments, reject reasons and the Post / Edit form (never sign-in / sign-up).
model KeptForm {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

/// Emails written instead of sent when RESEND_API_KEY is empty (/dev/outbox)
model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String   @default("")
  createdAt DateTime @default(now())
}

/// The developer invites a tester to join (the tester joins with the normal Join). No moves.
model Invite {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testerId  String
  /// "sent" | "cancelled" | "joined" | "declined" (the tester pressed "No thanks") | "replaced" (a listing change sent a new one)
  status    String   @default("sent")
  /// Bell reminder every 3 days until they join, decline, or the invite expires
  remindedAt DateTime?
  /// (Once per invite) told the test filled / told a spot opened
  fullNotifiedAt DateTime?
  openNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId, testerId])
}

/// The bell: every update for a user, whatever their email setting.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String    @default("")
  /// (Owner, Oct 30, batch 34 §5) Whose line it is: "developer", "tester", or null for the whole account (shown on both sides)
  side      String?
  /// (Design doc 9) The test the line is about (same-day lines about one test stack into one entry)
  testId    String?
  /// (Owner, Oct 26) Always its own line in the bell (never stacked): admin decisions, a test stopped, payment failures and holds starting,
  /// a hold or pause lifted, a chargeback
  own       Boolean   @default(false)
  /// (Owner, Oct 26) Lines with the same group stack together on one day even across tests ("invites", "charge", "unreviewed", "paused", "payout", "disputes")
  groupKey  String?
  /// (Owner, Oct 26) Payment-related (failures, holds, retries, paid, rejected, delayed, payouts, chargebacks): also emailed in the end-of-day email
  payment   Boolean   @default(false)
  /// (Owner, Oct 27) One of the few emails that ignore Off (account paused / active again, the team paused / stopped / closed your test, the owed reminder): it goes in the end-of-day email, never right away
  mustEmail Boolean   @default(false)
  /// (Owner, Oct 27) Reminders also go in the summary email, each line once; a Weekly / Monthly email keeps only the newest copy of each reminder (same reminderKey)
  reminderKey String?
  readAt    DateTime?
  /// Included in a daily summary email (users on "One daily summary")
  summarizedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// (Batch 15 section 41, L3) Stripe webhook events already handled: a repeated delivery is skipped.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

/// Small app-wide values (e.g. when the last admin digest went out).
model AppState {
  key   String @id
  value String
}

/// After an Edit that changes contract terms, each working tester is offered the new terms (Switch / Keep).
model TermsOffer {
  id             String    @id @default(cuid())
  contractId     String
  testId         String
  listingVersion Int
  writtenCents   Int?
  recordingCents Int?
  liveRateCents  Int?
  liveMinutes    Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  deadlineDays   Int
  questions      Json
  /// (Design doc 5) The NDA text of the offered terms, and the questions / NDA the tester was on when it was offered (their terms history)
  ndaText        String    @default("")
  fromQuestions  Json?
  fromNdaText    String    @default("")
  /// "written $8 → $10, added a recording ($12)"
  diff           String
  /// (Batch 15 section 43) The Save that made this offer (its entry in the developer's Contract changes)
  changeId       String?
  /// "open" | "switched" | "kept" | "superseded"
  status         String    @default("open")
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([contractId, createdAt])
}

/// Either side can block the other. Never revealed to the blocked person.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// "Apply to join" (tests where Who can join = Apply). The developer Accepts or Declines.
model Application {
  id         String    @id @default(cuid())
  testId     String
  testerId   String
  note       String    @default("")
  /// "apply" (Apply to join) | "rejoin" (a tester who left or was ended asks to come back; the developer accepts)
  kind       String    @default("apply")
  /// The listing when they applied (to tell whether anything changed since)
  listing    Json
  /// (Design doc 7.3) When they accepted the test's NDA while applying
  ndaAcceptedAt DateTime?
  /// "pending" | "accepted" | "declined" | "withdrawn" | "joined"
  status     String    @default("pending")
  /// Set when the test switched to Anyone but something else changed since they applied
  changedAt  DateTime?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([testId, testerId])
  /// Why it closed: "listing" (a listing change) | "invite_only" (the test became invite only)
  closedReason String @default("")
}

/** "Request a time" from either side (pending until the other side accepts or declines; auto-booked on a match). */
model CallRequest {
  id           String    @id @default(cuid())
  testId       String
  contractId   String
  /// "developer" | "tester"
  fromSide     String
  startsAt     DateTime
  minutes      Int
  /// "pending" | "booked" | "declined" | "withdrawn" | "closed" | "taken" (another tester accepted this batch first)
  status       String    @default("pending")
  closedReason String    @default("")
  /// A developer request sent to several testers shares one batch: the first Accept books it
  batchId      String    @default("")
  /// The tester's "Ask $___/h" (null = the contract call rate)
  askRateCents Int?
  /// "Choose one": up to 3 possible times (startsAt is the first). Weekly: one time repeated `weeks` weeks (2-8).
  times        DateTime[]
  /// Repeat: "daily" | "weekly" ("" = choose one); `weeks` is the number of calls (2-8)
  repeat       String    @default("")
  weeks        Int       @default(0)
  /// (NEXT-UI 7) The rows: [{ startsAt, repeat: "once" | "daily" | "weekly", count }] (count 2-8, 0 = Forever); null on older requests
  rows         Json?
  callId       String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contractId, status])
}

/// (NEXT-UI 7) A booked daily / weekly run of calls (counted 2-8, or Forever: the next 4 ahead are booked, the daily job adds the next)
model CallSet {
  id         String   @id @default(cuid())
  testId     String
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// "daily" | "weekly"
  repeat     String
  /// 2-8 calls; 0 = Forever
  count      Int
  minutes    Int
  rateCents  Int?
  /// The next occurrence the daily job books (Forever sets)
  nextAt     DateTime
  /// "active" | "cancelled" | "ended" (the tester's part ended, or the test stopped)
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@index([contractId, status])
}

/// Everything a person did on a test (from any tab): reason E for the stop-once boxes ("You also did this in another tab").
model ActionLog {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  text      String
  /// The browser tab (page load) that did it; that tab's own presses never stop for it.
  tab       String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, testId, createdAt])
}

/// (NEWEST+5) One rating per side per test (contract), final. side = who rated: "tester" (rates the developer) | "developer" (rates the tester).
model Rating {
  id         String   @id @default(cuid())
  testId     String
  contractId String
  side       String
  raterId    String
  rateeId    String
  stars      Int
  comment    String   @default("")
  /// Blind reveal: a tester's rating shows once the developer rates (or 14 days pass); the developer's at once.
  revealedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([contractId, side])
  @@index([rateeId])
}

/// (NEWEST+6) The app and the database answered (GET /api/health, page polls, the daily job).
model Heartbeat {
  id String   @id @default(cuid())
  at DateTime @default(now())

  @@index([at])
}

/// (NEWEST+6) A gap of more than 15 minutes between heartbeats: recorded once; every running timer moved by its length.
model Outage {
  id         String   @id @default(cuid())
  startAt    DateTime @unique
  endAt      DateTime
  ms         Int
  recordedAt DateTime @default(now())
  /// (Batch 15 section 41, M4) Longer than 24 hours: nothing moves until an admin approves it
  needsApproval Boolean   @default(false)
  approvedAt    DateTime?
  approvedById  String?
}

/// (Design doc 5) A test's access keys. status: "free" (available) | "inuse" (a working tester has it) | "broken" (that tester reported it) |
/// "held" (its tester left or was ended: not free, not reusable; they get it back if they return) | "retired" (replaced or removed: can never be added again).
model AccessKey {
  id         String    @id @default(cuid())
  testId     String
  test       Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  value      String
  status     String    @default("free")
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  brokenAt   DateTime?
  /// (Batch 15 section 45) The developer dismissed the "doesn't work" warning for this report (a later report shows again), or marked the key as working
  brokenDismissedAt DateTime?
  fixedAt    DateTime?
  /// (Batch 15 section 44) Typed back into Free from a tester who left or finished: their name, and whether it had been reported as broken
  reusedFrom   String  @default("")
  reusedBroken Boolean @default(false)
  createdAt  DateTime  @default(now())

  @@unique([testId, value])
  @@index([testId, status])
}

/// (Owner, Oct 27) "Report <name>" on a profile: one report per pair, ever. The admin sees it in the reports list.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([reporterId, reportedId])
  @@index([reportedId])
}

/// (Owner, Oct 27) The admin's account history: payment holds starting / lifting / approved, suspensions and reinstatements, with the admin who acted.
model AccountEvent {
  id        String   @id @default(cuid())
  userId    String
  /// "hold" | "hold-lifted" | "hold-approved" | "suspended" | "reinstated"
  kind      String
  byId      String?
  note      String   @default("")
  /// (Batch 15 section 16) For suspensions and reinstatements: "developer" | "tester" ("" = the whole account, before batch 15)
  side      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// (Owner, Oct 27) A Contact us message: at most 5 per account per day.
/// (Owner, Oct 30, batch 15 section 21) Every admin action, with the admin who did it: admin views name them by email ("an admin (deleted)" once that account is gone).
/// Developers and testers never see which admin; they read "the team".
model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  /// The admin route's action: "pause-test", "stop-test", "suspend", "delete-account", "release-share", "refund-share", "allow-critical-changes", "approve-hold" ...
  action    String
  /// What it acted on (a test, an account, a payment, a dispute, a contact message)
  targetId  String
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([adminId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  /// (Batch 15 section 21) The message itself (up to 50,000 characters), for the admin's list; and which admin marked it replied, and when
  message   String   @default("")
  repliedById String?
  repliedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// (Owner, Oct 29, batch 13) A tester's request to show a short excerpt of written work the developer paid for on their public profile. The test's developer allows or
/// denies it. Never stopped by stop-once, blocks, suspensions or holds; hidden (not deleted) while the test has an NDA.
model Excerpt {
  id           String     @id @default(cuid())
  testerId     String
  tester       User       @relation(fields: [testerId], references: [id], onDelete: Cascade)
  testId       String
  test         Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  contractId   String
  contract     Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// The question it answers, and the quote: plain text, 10 to 500 characters, trimmed from that answer
  question     String     @default("")
  text         String
  /// "Don't name the product" (ticked by default)
  hideProduct  Boolean    @default(true)
  /// "pending" | "shown" | "denied" | "closed" (the developer deleted their account while it waited)
  status       String     @default("pending")
  closedReason String     @default("")
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([testerId, status])
  @@index([testId, status])
}

/// (Batch 17 §18) A test whose join page this tester opened while not in it (no contract): the tester dashboard's "Tests visited", most recent visit first.
/// One row per tester and test (`visitedAt` = the last visit). Remove deletes the row; opening the join page again brings it back.
model TestVisit {
  id        String   @id @default(cuid())
  testerId  String
  tester    User     @relation(fields: [testerId], references: [id], onDelete: Cascade)
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([testerId, testId])
  @@index([testerId, visitedAt])
  @@index([testId])
}

/// (Owner, Oct 29, batch 23 section 1) Every email sent through Resend is stored here first, then sent; a failure keeps it pending with the error and a next try. The 5-minute
/// sweep retries it after 5, 15 and 30 minutes, then hourly, for 48 hours; then it is failed for good (kept, never deleted). Sent at most once (Resend's Idempotency-Key is the row id).
/// (In development without RESEND_API_KEY, emails still go to the dev outbox, OutboxEmail.)
model EmailQueue {
  id          String    @id @default(cuid())
  to          String
  subject     String
  text        String
  html        String    @default("")
  /// "pending" | "sent" | "failed" (failed for good)
  status      String    @default("pending")
  /// Tries that failed or went through (a daily-limit wait isn't counted)
  attempts    Int       @default(0)
  /// The last failure, short (Resend's status and message); "" before any failure
  lastError   String    @default("")
  /// "cap": Resend's daily limit was reached (it waits for the next day's first sweep)
  errorKind   String    @default("")
  /// When it is tried next (also a claim: a sweep taking it moves this 10 minutes on, so overlapping sweeps send it once)
  nextTryAt   DateTime  @default(now())
  /// The 48 hours of tries end here (a daily-limit wait moves it later by the wait)
  giveUpAt    DateTime
  lastTriedAt DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  /// An admin cleared it from the console's failed-for-good list (the row is kept)
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, nextTryAt])
}

/// (Owner, Oct 29, batch 23 section 6) During a chargeback hold, Pay what you owe reserves the owed total on the card (a Stripe PaymentIntent with capture_method manual) instead
/// of charging it; the team's Approve captures it (the owed payments it covers are then paid) and lifts the hold. Not approved: cancelled (nothing taken). Unused after about 7 days:
/// expired (released; the developer presses Pay what you owe again).
model Reservation {
  id                    String    @id @default(cuid())
  developerId           String
  amountCents           Int
  /// The owed payments it covers (Payment ids; an open chargeback's own payment stands for its repay)
  covers                String[]
  /// "pending" (being made) | "needs_action" (the bank's check is open) | "reserved" | "captured" | "cancelled" | "expired" | "failed"
  status                String    @default("pending")
  stripePaymentIntentId String?
  /// While the bank's check is open: by when it must finish (15 minutes)
  actionBy              DateTime?
  /// When the reservation lapses (about 7 days after it was made)
  expiresAt             DateTime?
  capturedAt            DateTime?
  endedAt               DateTime?
  createdAt             DateTime  @default(now())

  @@index([developerId, status])
}
