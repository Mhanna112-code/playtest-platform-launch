generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Money is always whole cents (Int).

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String    @default("")
  /// "she" | "he" | "they" | "" (blank: wording uses "they")
  pronoun     String    @default("")
  isDeveloper Boolean   @default(false)
  /// (NEXT-UI 6) The side in use now when the account has both: "developer" | "tester" ("" = not chosen yet)
  side        String    @default("")
  isTester    Boolean   @default(false)
  isAdmin     Boolean   @default(false)
  /// (NEWEST+7) bcrypt hash ("" = no password yet: set one through Forgot password)
  passwordHash    String    @default("")
  emailVerifiedAt DateTime?
  suspendedAt DateTime?
  suspendNote String    @default("")
  /// (Design doc 11.4) The admin who suspended the account, and when it was lifted (the "Your account is active again" notice)
  suspendedById String?
  reinstatedAt  DateTime?
  /// (Design doc 2, 10) A deleted account: when, by whom ("self" | "admin") and why. History stays; nothing else of it works.
  deletedAt     DateTime?
  deletedBy     String    @default("")
  deleteReason  String    @default("")
  /// (Design doc 9) A tester's payout failed ("Your bank couldn't receive a payout"): since when, and the last 3-day bell reminder
  /// (Design doc 6) The Alerts menu: update types the developer chose NOT to be stopped for (see src/lib/alerts.ts)
  ignoredAlerts     String[]  @default([])
  payoutProblemAt   DateTime?
  payoutRemindedAt  DateTime?
  createdAt   DateTime  @default(now())

  /// Stripe: developer's customer + saved card; tester's Connect account
  stripeCustomerId      String? @unique
  stripePaymentMethodId String?
  stripeAccountId       String? @unique
  payoutsReady          Boolean @default(false)
  /// (Owner, Oct 28, batch 8) The developer subscription ($7/month): "none" | "active" | "past_due" (a renewal was declined; Stripe retries for about a week, the perks
  /// continue) | "ended" (subscriptionEndReason: "cancelled" | "lapsed" | "deleted")
  subscriptionStatus     String    @default("none")
  /// The Stripe subscription id, or "manual" when Stripe Billing isn't set up (renewals recorded by the daily job)
  subscriptionId         String?
  subscribedAt           DateTime?
  /// The day renewals count from (monthly; the 31st renews on the last day of shorter months). Moves later by the time billing was paused
  subscriptionAnchorAt   DateTime?
  /// The end of the paid month: the next renewal, or the end when cancelled
  subscriptionRenewsAt   DateTime?
  subscriptionCanceling  Boolean   @default(false)
  subscriptionEndedAt    DateTime?
  subscriptionEndReason  String    @default("")
  /// When a declined renewal made it past due (the lapse comes after the last retry)
  subscriptionPastDueAt  DateTime?
  /// Billing paused by a payment hold, a chargeback hold or a suspension (the paid days left resume when it lifts)
  subscriptionPausedAt   DateTime?
  /// Payment hold: set while the developer owes money (a failed charge unpaid after 3 days, or a chargeback)
  holdStartedAt DateTime?
  holdReason    String    @default("")
  /// (Owner, Oct 27) How many payment holds this account has had (each start counts). After the 3rd, every later hold needs an admin's Approve to lift
  /// (holdApprovedAt), even once what is owed is paid. Cleared when a hold lifts.
  holdCount      Int       @default(0)
  holdApprovedAt DateTime?
  holdApprovedById String?
  /// No longer used (the 30-day admin alert was replaced by closing paused tests after 7 days); kept so the running app's client still matches
  holdAlertedAt DateTime?
  /// (Owner, Oct 26) A chargeback hold lifts only after: a card re-verified with 3D Secure (chargebackCardVerifiedAt), what is owed paid,
  /// and the admin's approval (chargebackApprovedAt). Both are cleared when the hold lifts or a new chargeback opens.
  chargebackCardVerifiedAt DateTime?
  chargebackApprovedAt     DateTime?
  /// Email settings (Owner, Oct 26): "off", or on with "daily" (default) | "weekly" | "monthly". One email lists every notification since the last one;
  /// payment lines also go out in an end-of-day email for weekly / monthly. The always-send emails (account paused ...) ignore it. The bell keeps everything.
  emailPref     String    @default("daily")
  /// Last summary email (daily / weekly / monthly settings)
  lastSummaryAt DateTime?
  /// (NEWEST+9) The most testers per test this developer has earned so far (it never shrinks; see src/lib/capacity.ts)
  testerLimit   Int       @default(10)

  notifications Notification[]

  sessions  Session[]
  profile   TesterProfile?
  tests     Test[]
  contracts Contract[]
  messages  Message[]
  chatReads ChatRead[]
  keptForms KeptForm[]
}

/// One-use sign-in link tokens (only the SHA-256 hash is stored)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  /// "reset" (choose a new password) | "verify" (confirm the email) | "login" (old email links, no longer issued)
  kind      String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TesterProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices    String[]
  categories String[]
  languages  String[]
  bio        String   @default("")
  updatedAt  DateTime @updatedAt
}

model Test {
  id          String   @id @default(cuid())
  developerId String
  developer   User     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  title       String
  /// (Design doc 4) The game, website, app or other product (60 characters); the title above is this test's own name (60)
  productName String   @default("")
  /// (Design doc 4) Mature (18+): the developer says why the content is mature (required when ticked)
  mature      Boolean  @default(false)
  matureWhy   String   @default("")
  /// (Design doc 4) Optional NDA: text testers must accept before joining ("" = none)
  ndaText     String   @default("")
  /// (Owner, Oct 28 afternoon) Per limited field, the Saves that changed it after the first tester joined: { description, ndaText, questions, languages, devices } (a missing key = 0).
  /// Each field has its OWN limit of 3. Prices, parts, the build link and access keys are not limited
  criticalCounts Json @default("{}")
  /// (Design doc 6, 10) An admin paused this test (it behaves like a stop for the developer, who can only stop it) or stopped it, and the note
  adminPausedAt   DateTime?
  adminStoppedAt  DateTime?
  adminNote       String   @default("")
  /// (Owner, Oct 26) Which admin paused / stopped it (the admin dashboard lists each admin's own actions)
  adminPausedById  String?
  adminStoppedById String?
  /// (Owner, Oct 26) A paused test closes after 7 days (whatever the cause). The admin can move that date (valid only if set during the
  /// current pause: pauseCloseSetAt >= the pause's start); pauseClosedAt/Reason record a closure caused by the pause.
  pauseCloseAt      DateTime?
  pauseCloseSetAt   DateTime?
  pauseClosedAt     DateTime?
  pauseClosedReason String   @default("")
  description String   @default("")
  buildUrl    String   @default("")
  /// The full app's categories (at least one)
  categories  String[] @default([])
  /// Devices a tester needs (any one of them); empty = any device
  devices     String[]
  languages   String[]
  spots       Int
  /// Prices in cents; null = this kind of work isn't offered; 0 = free
  writtenCents   Int?
  recordingCents Int?
  /// Live call: hourly rate (cents) and booked length (minutes); null = no live call
  liveRateCents Int?
  liveMinutes   Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  /// Each tester's deadline: days from their own join (late work is still allowed, marked "Sent late")
  deadlineDays  Int
  /// After this date: no new joiners, no sending, no booking (null = no end date)
  openUntil     DateTime?
  /// Questions for written answers (array of strings)
  questions     Json     @default("[]")
  /// Who can join: "anyone" (Join) | "apply" (Apply to join; the developer accepts) | "invite" (invite only)
  joinMode      String   @default("anyone")
  /// "draft" | "open" | "closed" (no new joiners) | "stopped" (for good)
  status        String   @default("open")
  round         Int      @default(1)
  previousId    String?
  /// Any change to the test (edit, join that used a spot, next round, stop): checked by Edit's Save
  version       Int      @default(1)
  /// Changes to the listing's terms only: checked by Join
  listingVersion Int     @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stoppedAt     DateTime?

  contracts Contract[]
  slots     CallSlot[]
  events    TestEvent[]
  invites   Invite[]
  accessKeys AccessKey[]
  /// Open until heads-up notices sent (3 days and 1 day before)
  notified3d Boolean @default(false)
  /// Countdown notices already sent for Open until: "1m" | "1w" | "3d" | "1d"
  notifiedMarks String[]
  notified1d Boolean @default(false)

  @@index([developerId])
  @@index([status])
}

/// What happened on a test: feeds the stop-once box (top panel) and Edit's "what changed" list.
model TestEvent {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  /// Stop-once kinds: "joined" | "left" | "sent" | "booked" | "confirmed" | "cancelled" | "offered" | "removed" | "paid".
  /// Others: "edited" | "next_round" | "stopped" | "ended" | "opened"
  kind      String
  text      String
  /// The tester this is about (for the Pay box's stop-once check), if any
  contractId String?
  /// The test's version after this event (when it changed the version)
  version   Int?
  createdAt DateTime @default(now())

  @@index([testId, createdAt])
}

/// A tester's place in a test. Every term is copied from the listing at join and never changes.
model Contract {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testerId  String
  tester    User     @relation(fields: [testerId], references: [id], onDelete: Cascade)
  /// The listing version the tester joined on
  listingVersion Int
  title          String
  buildUrl       String
  description    String
  writtenCents   Int?
  recordingCents Int?
  liveRateCents  Int?
  liveMinutes    Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  deadlineDays   Int
  questions      Json
  keepPrivate    Boolean  @default(false)
  /// (Design doc 4) The NDA the tester accepted when they joined ("" = none) and when
  ndaText        String   @default("")
  ndaAcceptedAt  DateTime?
  joinedAt       DateTime @default(now())
  dueAt          DateTime
  /// "working" | "left" | "ended" (developer ended early / stopped the test)
  status         String   @default("working")
  endedAt        DateTime?
  /// When the tester switched to newer terms offered after an Edit (null = still on their original terms)
  termsSwitchedAt DateTime?
  /// "early" (developer ended this tester's work) | "stopped" (the developer stopped the test)
  endKind        String   @default("")
  endReason      String   @default("")
  /// (NEWEST+5) "Rate ..." prompt sent once, when rating first became available (tester side / developer side)
  ratePromptedAt    DateTime?
  devRatePromptedAt DateTime?
  /// (Owner, Oct 27) A tester removed by a suspension dismissed the "Suspended" card on their dashboard
  removedDismissedAt DateTime?

  submissions Submission[]
  recordings  Recording[]
  calls       Call[]
  callSets    CallSet[]
  messages    Message[]
  accessKeys  AccessKey[]

  @@unique([testId, testerId])
  @@index([testerId])
}

/// Sent work: "written" (answers to the contract's questions) or "recording" (uploaded recordings).
model Submission {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String
  /// Written: array of answers, one per question
  answers    Json     @default("[]")
  notes      String   @default("")
  /// The listing price for this part from the contract; null = extra work (not in the listing)
  agreedCents Int?
  /// First sent; updated when the tester sends an updated version (allowed until it's paid)
  sentAt     DateTime @default(now())
  updatedAt  DateTime @default(now())
  /// Sent after the tester's own deadline
  late       Boolean  @default(false)
  /// Not paid or rejected by then: the listing amount is paid automatically (moves on with payment holds)
  payBy      DateTime?
  /// Optional "Ask $___ for this" when sending
  askedCents Int?
  /// Last reminder (every 3 days): to the developer for parts outside the contract, to the tester for a waiting choice
  remindedAt DateTime?
  /// Contract parts unreviewed 14 days: the tester chooses "Charge" or "Let it go" by choiceBy, else it's charged
  choiceOfferedAt DateTime?
  /// Countdown notices to the developer before day 14 ("1w" | "3d" | "1d"), then daily after it
  devMarks        String[]
  devRemindedAt   DateTime?
  choiceBy        DateTime?

  recordings Recording[]
  review     Review?
  dispute    Dispute?

  @@unique([contractId, kind])
}

model Recording {
  id           String      @id @default(cuid())
  contractId   String
  contract     Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  storageKey   String
  filename     String
  sizeBytes    Int
  contentType  String
  /// Set once the upload finished
  uploadedAt   DateTime?
  createdAt    DateTime    @default(now())
}

/// The developer's one Pay (or Reject) press for a piece of sent work or a held call. One per piece.
model Review {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  callId       String?     @unique
  call         Call?       @relation(fields: [callId], references: [id], onDelete: Cascade)
  contractId   String
  amountCents  Int
  /// The listing amount shown beside the box; null = not in the listing
  agreedCents  Int?
  reason       String      @default("")
  /// Reject: nothing charged (amountCents 0); a contract part can still be disputed once
  rejected     Boolean     @default(false)
  /// Paid automatically after 14 days without a review
  auto         Boolean     @default(false)
  /// Idempotency: one charge per press, never twice
  payKey       String      @unique
  createdAt    DateTime    @default(now())

  @@index([contractId])
}

/// Every charge (or attempted charge). status: "pending" | "charged" | "not_set_up" (no Stripe key: recorded only) | "failed"
model Payment {
  id           String   @id @default(cuid())
  /// "review" | "call" | "dispute"
  kind         String
  submissionId String?
  callId       String?
  disputeId    String?
  contractId   String?
  developerId  String
  testerId     String
  amountCents  Int
  feeCents     Int
  testerCents  Int
  status       String
  stripePaymentIntentId String?
  /// The tester's share: "sent" (to their Stripe account with the charge), "waiting" (no payout account yet), "none"
  transferStatus String @default("none")
  stripeTransferId String?
  /// A failed charge the developer still owes must be paid by this time, or a payment hold starts
  owedUntil    DateTime?
  /// The daily job retries owed payments once a day
  retriedAt    DateTime?
  /// The "1 day before the cut-off" notice was sent
  warnedAt     DateTime?
  settledAt    DateTime?
  /// Bank reversal (Stripe dispute): "" | "open" | "resolved"
  chargeback   String   @default("")
  chargebackAt DateTime?
  stripeChargeId String?
  /// (Owner, Oct 27) A chargeback adds its amount to what the developer owes; this payment is the card charge that repays that reversed payment
  repaysId     String?
  failure      String   @default("")
  createdAt    DateTime @default(now())

  @@index([developerId])
  @@index([testerId])
}

/// Only for parts in the contract paid below the listing amount; once per part.
model Dispute {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  callId       String?     @unique
  call         Call?       @relation(fields: [callId], references: [id], onDelete: Cascade)
  contractId   String
  testerId     String
  reason       String
  /// The developer's side, added once (shown under the piece; the admin sees both)
  devSide      String      @default("")
  devSideAt    DateTime?
  /// "open" | "decided" | "withdrawn" (owner, Oct 28: the tester deleted their account)
  status       String     @default("open")
  /// The total pay the admin decided (never below what was paid)
  decidedCents Int?
  decisionNote String     @default("")
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())
}

/// A call time the developer offers. Booked by one tester.
model CallSlot {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  minutes     Int
  /// Empty = every tester with a live call in their contract can book; otherwise only these tester ids
  allowedTesterIds String[]
  /// Optional meeting link; without one the call uses the site's simple room page
  link        String   @default("")
  /// "open" | "booked" | "removed"
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calls Call[]

  @@index([testId, startsAt])
}

model Call {
  id          String    @id @default(cuid())
  slotId      String
  slot        CallSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  minutes     Int
  /// The contract's hourly rate; null = extra (live calls weren't in the tester's listing)
  rateCents   Int?
  /// "booked" | "cancelled"
  status      String    @default("booked")
  cancelledBy String?
  cancelledAt DateTime?
  cancelNote  String    @default("")
  /// Optional "Ask $___ for this" when booking
  askedCents  Int?
  /// The daily/weekly set this call belongs to (the request it came from); shown as one line
  setId          String?
  /// Each side's first Join (the call page shows "Both joined at …"; the length defaults from then to the booked end)
  devJoinedAt    DateTime?
  testerJoinedAt DateTime?
  /// The actual length the developer entered after the call (sets the Pay box reference); null = booked length
  actualMinutes Int?
  /// (The full app's "Why, if shorter") The developer's reason when the length entered is shorter than booked
  lengthNote    String  @default("")
  /// No-show report: who reported ("developer" | "tester"), what happened; an admin can read it
  noShowBy      String?
  noShowNote    String  @default("")
  noShowAt      DateTime?
  /// Listed in an admin digest once
  noShowDigestedAt DateTime?
  createdAt   DateTime  @default(now())

  review  Review?
  dispute Dispute?

  @@index([contractId])
}

/// Per-test chat between the developer and one tester (in the test, invited, applied, or a past participant).
model Message {
  id         String   @id @default(cuid())
  testId     String   @default("")
  testerId   String   @default("")
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
  @@index([testId, testerId, createdAt])
}

/// (NEXT-UI 4) When each person last opened a chat (per test and tester): the unread badge counts the other side's messages after it
model ChatRead {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId   String
  testerId String
  readAt   DateTime @default(now())

  @@id([userId, testId, testerId])
}

/// (NEXT-UI 10) Typed but not sent: kept on the server per person and form (any device), put back with "Not sent yet"; sending clears it.
/// Only written answers, chat messages, dispute text, rating comments, reject reasons and the Post / Edit form (never sign-in / sign-up).
model KeptForm {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

/// Emails written instead of sent when RESEND_API_KEY is empty (/dev/outbox)
model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String   @default("")
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  /// "developer" | "tester" | "both"
  role      String   @default("both")
  createdAt DateTime @default(now())
}

/// The developer invites a tester to join (the tester joins with the normal Join). No moves.
model Invite {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testerId  String
  /// "sent" | "cancelled" | "joined" | "declined" (the tester pressed "No thanks") | "replaced" (a listing change sent a new one)
  status    String   @default("sent")
  /// Bell reminder every 3 days until they join, decline, or the invite expires
  remindedAt DateTime?
  /// (Once per invite) told the test filled / told a spot opened
  fullNotifiedAt DateTime?
  openNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId, testerId])
}

/// The bell: every update for a user, whatever their email setting.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String    @default("")
  /// (Design doc 9) The test the line is about (same-day lines about one test stack into one entry)
  testId    String?
  /// (Owner, Oct 26) Always its own line in the bell (never stacked): admin decisions, a test stopped, payment failures and holds starting,
  /// a hold or pause lifted, a chargeback
  own       Boolean   @default(false)
  /// (Owner, Oct 26) Lines with the same group stack together on one day even across tests ("invites", "charge", "unreviewed", "paused", "payout", "disputes")
  groupKey  String?
  /// (Owner, Oct 26) Payment-related (failures, holds, retries, paid, rejected, delayed, payouts, chargebacks): also emailed in the end-of-day email
  payment   Boolean   @default(false)
  /// (Owner, Oct 27) One of the few emails that ignore Off (account paused / active again, the team paused / stopped / closed your test, the owed reminder): it goes in the end-of-day email, never right away
  mustEmail Boolean   @default(false)
  /// (Owner, Oct 27) Reminders also go in the summary email, each line once; a Weekly / Monthly email keeps only the newest copy of each reminder (same reminderKey)
  reminderKey String?
  readAt    DateTime?
  /// Included in a daily summary email (users on "One daily summary")
  summarizedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Small app-wide values (e.g. when the last admin digest went out).
model AppState {
  key   String @id
  value String
}

/// After an Edit that changes contract terms, each working tester is offered the new terms (Switch / Keep).
model TermsOffer {
  id             String    @id @default(cuid())
  contractId     String
  testId         String
  listingVersion Int
  writtenCents   Int?
  recordingCents Int?
  liveRateCents  Int?
  liveMinutes    Int?
  /// (NEWEST+10) "Required" on each part: a label only (part of the terms; blocks nothing)
  writtenRequired   Boolean @default(false)
  recordingRequired Boolean @default(false)
  liveRequired      Boolean @default(false)
  deadlineDays   Int
  questions      Json
  /// (Design doc 5) The NDA text of the offered terms, and the questions / NDA the tester was on when it was offered (their terms history)
  ndaText        String    @default("")
  fromQuestions  Json?
  fromNdaText    String    @default("")
  /// "written $8 → $10, added a recording ($12)"
  diff           String
  /// "open" | "switched" | "kept" | "superseded"
  status         String    @default("open")
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([contractId, createdAt])
}

/// Either side can block the other. Never revealed to the blocked person.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// "Apply to join" (tests where Who can join = Apply). The developer Accepts or Declines.
model Application {
  id         String    @id @default(cuid())
  testId     String
  testerId   String
  note       String    @default("")
  /// "apply" (Apply to join) | "rejoin" (a tester who left or was ended asks to come back; the developer accepts)
  kind       String    @default("apply")
  /// The listing when they applied (to tell whether anything changed since)
  listing    Json
  /// (Design doc 7.3) When they accepted the test's NDA while applying
  ndaAcceptedAt DateTime?
  /// "pending" | "accepted" | "declined" | "withdrawn" | "joined"
  status     String    @default("pending")
  /// Set when the test switched to Anyone but something else changed since they applied
  changedAt  DateTime?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([testId, testerId])
  /// Why it closed: "listing" (a listing change) | "invite_only" (the test became invite only)
  closedReason String @default("")
}

/** "Request a time" from either side (pending until the other side accepts or declines; auto-booked on a match). */
model CallRequest {
  id           String    @id @default(cuid())
  testId       String
  contractId   String
  /// "developer" | "tester"
  fromSide     String
  startsAt     DateTime
  minutes      Int
  /// "pending" | "booked" | "declined" | "withdrawn" | "closed" | "taken" (another tester accepted this batch first)
  status       String    @default("pending")
  closedReason String    @default("")
  /// A developer request sent to several testers shares one batch: the first Accept books it
  batchId      String    @default("")
  /// The tester's "Ask $___/h" (null = the contract call rate)
  askRateCents Int?
  /// "Choose one": up to 3 possible times (startsAt is the first). Weekly: one time repeated `weeks` weeks (2-8).
  times        DateTime[]
  /// Repeat: "daily" | "weekly" ("" = choose one); `weeks` is the number of calls (2-8)
  repeat       String    @default("")
  weeks        Int       @default(0)
  /// (NEXT-UI 7) The rows: [{ startsAt, repeat: "once" | "daily" | "weekly", count }] (count 2-8, 0 = Forever); null on older requests
  rows         Json?
  callId       String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contractId, status])
}

/// (NEXT-UI 7) A booked daily / weekly run of calls (counted 2-8, or Forever: the next 4 ahead are booked, the daily job adds the next)
model CallSet {
  id         String   @id @default(cuid())
  testId     String
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// "daily" | "weekly"
  repeat     String
  /// 2-8 calls; 0 = Forever
  count      Int
  minutes    Int
  rateCents  Int?
  /// The next occurrence the daily job books (Forever sets)
  nextAt     DateTime
  /// "active" | "cancelled" | "ended" (the tester's part ended, or the test stopped)
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@index([contractId, status])
}

/// Everything a person did on a test (from any tab): reason E for the stop-once boxes ("You also did this in another tab").
model ActionLog {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  text      String
  /// The browser tab (page load) that did it; that tab's own presses never stop for it.
  tab       String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, testId, createdAt])
}

/// (NEWEST+5) One rating per side per test (contract), final. side = who rated: "tester" (rates the developer) | "developer" (rates the tester).
model Rating {
  id         String   @id @default(cuid())
  testId     String
  contractId String
  side       String
  raterId    String
  rateeId    String
  stars      Int
  comment    String   @default("")
  /// Blind reveal: a tester's rating shows once the developer rates (or 14 days pass); the developer's at once.
  revealedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([contractId, side])
  @@index([rateeId])
}

/// (NEWEST+6) The app and the database answered (GET /api/health, page polls, the daily job).
model Heartbeat {
  id String   @id @default(cuid())
  at DateTime @default(now())

  @@index([at])
}

/// (NEWEST+6) A gap of more than 15 minutes between heartbeats: recorded once; every running timer moved by its length.
model Outage {
  id         String   @id @default(cuid())
  startAt    DateTime @unique
  endAt      DateTime
  ms         Int
  recordedAt DateTime @default(now())
}

/// (Design doc 5) A test's access keys. status: "free" (available) | "inuse" (a working tester has it) | "broken" (that tester reported it) |
/// "held" (its tester left or was ended: not free, not reusable; they get it back if they return) | "retired" (replaced or removed: can never be added again).
model AccessKey {
  id         String    @id @default(cuid())
  testId     String
  test       Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  value      String
  status     String    @default("free")
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  brokenAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([testId, value])
  @@index([testId, status])
}

/// (Owner, Oct 27) "Report <name>" on a profile: one report per pair, ever. The admin sees it in the reports list.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([reporterId, reportedId])
  @@index([reportedId])
}

/// (Owner, Oct 27) The admin's account history: payment holds starting / lifting / approved, suspensions and reinstatements, with the admin who acted.
model AccountEvent {
  id        String   @id @default(cuid())
  userId    String
  /// "hold" | "hold-lifted" | "hold-approved" | "suspended" | "reinstated"
  kind      String
  byId      String?
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// (Owner, Oct 27) A Contact us message: at most 5 per account per day.
model ContactMessage {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
